# =========================================================
# SUPABASE CONFIGURATION
# Dapatkan Project URL & Anon Key dari Supabase Dashboard -> Project Settings -> API
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Opsional: URL publik aplikasi untuk tautan di dalam pesan notifikasi
NEXT_PUBLIC_SITE_URL=https://sebaraja.com

# =========================================================
# TELEGRAM BOT NOTIFICATION (SERVER-SIDE ONLY)
# 1. Buat bot di Telegram via @BotFather (/newbot) -> salin TELEGRAM_BOT_TOKEN
# 2. Cek Chat ID pribadi via @userinfobot (dan klik Start pada bot Anda) -> salin TELEGRAM_CHAT_ID
# 3. Jalankan `npm run notify:test` untuk mengetes pengiriman ke HP Anda
# =========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsional: Rahasia header `x-webhook-secret` jika ingin menembak `/api/notify` langsung dari Supabase Database Webhooks
TELEGRAM_WEBHOOK_SECRET=
